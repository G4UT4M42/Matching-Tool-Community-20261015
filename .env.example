# Documentation only: Start-Community-Demo.ps1 generates the token at runtime.
# Never commit an actual access token or financial data directory.
MATCHING_HTTP_HOST=127.0.0.1
PORT=3433
MATCHING_RUNTIME_MODE=external-runtime-root
MATCHING_RUNTIME_ROOT=REPLACE_WITH_AN_ABSOLUTE_LOCAL_DEMO_RUNTIME_PATH
MATCHING_LOCAL_ACCESS_TOKEN=GENERATED_BY_LOCAL_STARTER_NOT_STORED_HERE
MATCHING_ENABLE_BANK_AUTOMATION=false
NODE_ENV=production
